package {{ package_name }}.util;

import io.qameta.allure.Allure;
import io.restassured.response.Response;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.nio.charset.StandardCharsets;

/**
 * Allure attachment helper using UTF-8 byte decoding to prevent mojibake on non-ASCII responses.
 */
public final class ReportUtils {

    private static final Logger log = LoggerFactory.getLogger(ReportUtils.class);

    private ReportUtils() {
    }

    public static String getUtf8Body(Response response) {
        if (response == null || response.getBody() == null) {
            return "";
        }
        byte[] rawBytes = response.getBody().asByteArray();
        if (rawBytes == null || rawBytes.length == 0) {
            return "";
        }
        return new String(rawBytes, StandardCharsets.UTF_8);
    }

    public static void saveResponseAsAttachment(String name, Response response) {
        if (response == null) {
            return;
        }
        String contentType = response.getContentType();
        if (contentType == null || contentType.trim().isEmpty()) {
            contentType = "application/json";
        }
        int semicolon = contentType.indexOf(';');
        if (semicolon > 0) {
            contentType = contentType.substring(0, semicolon).trim();
        }
        String bodyContent = getUtf8Body(response);
        try {
            Allure.addAttachment(name + " (HTTP " + response.getStatusCode() + ")", contentType, bodyContent);
        } catch (Exception e) {
            log.warn("Failed to attach response '{}' to Allure: {}", name, e.getMessage());
        }
    }
}
