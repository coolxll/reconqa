# ReconQA Configuration
RECONQA_DATA_DIR=./workspaces
RECONQA_DATABASE_URL=sqlite+aiosqlite:///./workspaces/reconqa.db
RECONQA_BIN_DIR=./bin
RECONQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Target Auth (referenced by name, never hardcoded in generated tests)
# RECONQA_AUTH_TOKEN=
# RECONQA_AUTH_COOKIE=

# Optional k6 Proxy Egress
# RECONQA_K6_PROXY_URL=

# Optional OWASP ZAP Docker API
# RECONQA_ZAP_API_URL=http://localhost:8090
# RECONQA_ZAP_API_KEY=
