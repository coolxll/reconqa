            "mimeType": "application/javascript",
            "text": "// Sanitized fixture app.bundle.js for ReconQA tests\nconst CONFIG = {\n  stagingUrl: \"https://staging-api.internal.example.test/debug\",\n  internalHost: \"10.20.30.40\",\n  supportEmail: \"qa-bot@example.test\",\n  contactMobile: \"13800138000\",\n  apiKey: \"rk_test_dummy1234567890abcdef\"\n};\n\nconst routes = [\n  { path: \"/home\", name: \"Home\" },\n  { path: \"/items/:id\", name: \"ItemDetail\" },\n  { path: \"/cart\", name: \"Cart\" },\n  { path: \"/orders\", name: \"Orders\" }\n];\n\nfunction initMicroApps() {\n  registerMicroApps([\n    { name: \"checkout-subapp\", entry: \"//subapp.example.test/checkout\", activeRule: \"/subapp-checkout\" }\n  ]);\n}\n\nfunction searchItems(keyword) {\n  return axios.get(\"/api/v1/items/search\", { params: { keyword } });\n}\n\nfunction claimCoupon(code, uid) {\n  return axios.post(\"/api/v1/coupons/claim\", {\n    data: { couponCode: code, userId: uid }\n  }).then(function(res) {\n    return res.data.claimedId;\n  });\n}\n\nfunction loadPreferences() {\n  return fetch(\"/api/v1/user/preferences\");\n}"
